# =====================================================================
# heatmap module settings — EyePass SUITE
# Shared settings (Redis, MinIO, the camera relay, TZ/logging, which
# modules run) live in the ROOT .env and are layered on top of this
# file; they were removed from here: CAMERA_PING_TIMEOUT_SEC, CAMERA_RTSP_PORT, CAMERA_SNAPSHOT_DEBUG_ENABLED, CAMERA_SNAPSHOT_INTERVAL_SEC, CAMERA_SNAPSHOT_TIMEOUT_SEC, HLS_PORT, IMAGE_TAG, LOG_FORMAT, LOG_LEVEL, MINIO_ENDPOINT, MINIO_PUBLIC_URL, MINIO_ROOT_PASSWORD, MINIO_ROOT_USER, MINIO_SECURE, MONITOR_LOOP_INTERVAL_SEC, MTX_API_PORT, MTX_API_TIMEOUT_SEC, MTX_POLL_INTERVAL_SEC, MTX_RTSP_BASE_URL, OFFLINE_HOLD_SECONDS, REDIS_DB, REDIS_HOST, REDIS_PASSWORD, REDIS_PORT, REDIS_URL, REGISTER_CAMERA_TIMEOUT_SEC, REMOVE_FROM_MTX_TIMEOUT_SEC, RTMP_PORT, RTSP_PORT, SHARED_NETWORK, STREAM_BASE_URL, TEST_VIDEO_FILE, TRUST_MTX_ONLY, TZ, WEBRTC_ICE_UDP_PORT, WEBRTC_PORT
# =====================================================================

# =====================================================================
# EyePlate — Heatmap module (crowd-density heatmaps)
# ---------------------------------------------------------------------
#   cp .env.example .env
#
# .env is gitignored; THIS file is committed and is the reference for
# every variable the stack understands. Same layout as the plate/face/
# fire modules' own .env.example — dev vs prod is not a different
# file, it's different VALUES in this one.
#
# The pre-existing standalone build of this module ran its OWN Redis +
# MinIO via a compose.infra.yaml. That's dropped here: this module now
# points at the SAME shared Redis/MinIO every other module uses,
# matching the plate/face/fire pattern — one source of truth instead
# of four separate Redis/MinIO instances on one host.
# =====================================================================

# ---------------------------------------------------------------------
# PLATFORM
# ---------------------------------------------------------------------

# The shared docker network every module attaches to. Create it once:
#   docker network create eyeplate_net

# Tag for built images. Use a git sha or semver once you have CI.

# Redis key prefix owned by THIS module: every key becomes "<prefix>:...".
REDIS_MODULE=heatmap


# ---------------------------------------------------------------------
# REDIS  (compose.infra.yaml, or the platform's own — the SAME Redis
# the plate/face/fire modules and Django already talk to)
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# MINIO  (compose.infra.yaml, or the platform's own — the SAME MinIO
# the plate/face/fire modules use; heatmap cubes get their own bucket)
# ---------------------------------------------------------------------
MINIO_BUCKET=heatmap-data


# ---------------------------------------------------------------------
# MEDIAMTX / RTSP RELAY
# ---------------------------------------------------------------------
# Where ai_service pulls frames from. This module bundles its own
# mediamtx/camera_stream (see compose.yaml) on ports offset from the
# plate/face/fire modules' defaults so all four can run on one host
# without a collision. Point MTX_RTSP_BASE_URL at an EXISTING relay
# instead if this deployment already runs one shared by every module.


# What the FRONTEND uses to play a camera. No trailing slash.


# =====================================================================
# CAMERA-STREAM SERVICE (camera_stream)
# =====================================================================
MONITOR_IDLE_SLEEP_SEC=1.0

# ---- debug output (local bind volume — never MinIO) ---------------------
CAMERA_DEBUG_HOST_DIR=./debug_camera


# =====================================================================
# TEST VIDEO PUBLISHERS (--profile test-video only)
# =====================================================================
# Put a local test clip next to this .env and point TEST_VIDEO_FILE at
# it — every video_publisher_N service loops the SAME file into its
# own camera id (1, 2, 3). See README "Testing without real cameras".


# =====================================================================
# AI SERVICE (ai_service)
# =====================================================================

# ---- image ----------------------------------------------------------
# The GPU-enabled base image with torch/ultralytics/opencv already
# installed — the SAME image the plate/face/fire detectors build from.
# Swap this without touching any code.
AI_BASE_IMAGE=base_image_gpu:latest

AI_API_PORT=8002     # host

# ---- compute ----------------------------------------------------------
# auto | cpu | cuda | cuda:N — resolved per engine subprocess.
DETECTION_DEVICE=auto
# false => a requested-but-missing GPU logs a loud error and falls back
#          to CPU. true => that's a startup failure instead. Flip to
#          true once DETECTION_DEVICE is pinned to a real GPU.
STRICT_DEVICE=false
# Torch CPU threads per engine process (only matters on CPU with
# several engines — otherwise each grabs every core and they fight).
TORCH_NUM_THREADS=0
GPU_COUNT=1

# Operator-supplied: put your head/person-detection weights here.
# yolov8n.pt (COCO class 0 = person) works out of the box; swap for a
# head-detection model if you have one — CLASS_LABELS/target_classes
# in ai-service/src/config.py assume class 0 either way.
DETECTION_MODELS_DIR=./models/detection
MODEL_PATH=/models/yolov8n.pt
DETECTION_IMG_SIZE=800
DETECTION_CONF_THRESHOLD=0.25
# center | bottom_center — which point of each detection's bbox is
# accumulated into the grid.
POINT_MODE=center
# Only every Nth processed frame accumulates a point, to keep the
# cube's counts meaningful at typical camera framerates.
DETECTION_ACCUMULATION_INTERVAL=10

# ---- engine topology / self-healing ------------------------------------
MAX_CAMERAS_PER_ENGINE=6
DEFAULT_ENGINE_COUNT=1
ENGINE_SHUTDOWN_TIMEOUT_SEC=30

# ---- camera health ------------------------------------------------------
HEARTBEAT_TIMEOUT_SEC=15
CAMERA_OFFLINE_GRACE_SECONDS=5

# ---- heatmap cube ---------------------------------------------------------
# How often in-memory cubes are flushed to MinIO. Worst-case data-loss
# window on an UNCLEAN kill; a clean stop always flushes.
SAVE_INTERVAL_SECONDS=60
# Cube time granularity. 5 => 288 slots/day. CHANGING THIS CHANGES THE
# SHAPE OF EVERY NEW CUBE and breaks compatibility with existing ones.
TIME_RESOLUTION_MINUTES=5
# Grid resolution the frame is divided into for accumulation.
GRID_WIDTH=128
GRID_HEIGHT=72

# ---- legacy plain overlay (SAVE_OUTPUT), off by default -----------------
# Writes raw per-camera annotated video/frames with NO grid overlay —
# superseded by DETECTOR_DEBUG_VIDEO_ENABLED below. Kept only for
# parity with the pre-existing standalone build.
SAVE_OUTPUT=false
SAVE_AS_VIDEO=true

# ---- visual debug (grid + live density overlay), off by default ---------
# New in this rewrite — see README "Visual debug". Local bind mount
# only, never MinIO. Expensive; leave off unless actively eyeballing.
DETECTOR_DEBUG_VIDEO_ENABLED=false
DEBUG_VIDEO_HOST_DIR=./debug_video
DEBUG_VIDEO_SEGMENT_SECONDS=240
DEBUG_VIDEO_FPS=12
DEBUG_VIDEO_MAX_SEGMENTS=12
DEBUG_VIDEO_SCALE=1.0
DEBUG_VIDEO_EVERY_N=1
DEBUG_VIDEO_CODEC=mp4v
DEBUG_VIDEO_EXT=.mp4
DEBUG_VIDEO_JSONL=true


# =====================================================================
# SHARED
# =====================================================================
# text | json — see common/heatmapcore/logging_setup.py.
