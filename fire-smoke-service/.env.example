# =====================================================================
# fire-smoke module settings — EyePass SUITE
# Shared settings (Redis, MinIO, the camera relay, TZ/logging, which
# modules run) live in the ROOT .env and are layered on top of this
# file; they were removed from here: CAMERA_PING_TIMEOUT_SEC, CAMERA_RTSP_PORT, CAMERA_SNAPSHOT_DEBUG_ENABLED, CAMERA_SNAPSHOT_INTERVAL_SEC, CAMERA_SNAPSHOT_TIMEOUT_SEC, HLS_PORT, IMAGE_TAG, LOG_FORMAT, LOG_LEVEL, MINIO_ENDPOINT, MINIO_PUBLIC_URL, MINIO_ROOT_PASSWORD, MINIO_ROOT_USER, MINIO_SECURE, MONITOR_LOOP_INTERVAL_SEC, MTX_API_PORT, MTX_API_TIMEOUT_SEC, MTX_POLL_INTERVAL_SEC, MTX_RTSP_BASE_URL, OFFLINE_HOLD_SECONDS, REDIS_DB, REDIS_HOST, REDIS_PASSWORD, REDIS_PORT, REDIS_URL, REGISTER_CAMERA_TIMEOUT_SEC, REMOVE_FROM_MTX_TIMEOUT_SEC, RTMP_PORT, RTSP_PORT, SHARED_NETWORK, TEST_VIDEO_FILE, TRUST_MTX_ONLY, TZ, WEBRTC_ICE_UDP_PORT, WEBRTC_PORT
# =====================================================================

# =====================================================================
# EyePlate — Fire/Smoke module (detection + THREAT/RESOLUTION alerts)
# ---------------------------------------------------------------------
#   cp .env.example .env
#
# .env is gitignored; THIS file is committed and is the reference for
# every variable the stack understands. Same layout as the plate and
# face modules' own .env.example — dev vs prod is not a different
# file, it's different VALUES in this one.
# =====================================================================

# ---------------------------------------------------------------------
# PLATFORM
# ---------------------------------------------------------------------

# The shared docker network every module attaches to. Create it once:
#   docker network create eyeplate_net

# Tag for built images. Use a git sha or semver once you have CI.

# Redis key prefix owned by THIS module: every key becomes "<prefix>:...".
# Keep this "fire" unless you're migrating an already-deployed backend
# integration that expects a different prefix.
REDIS_MODULE=fire


# ---------------------------------------------------------------------
# REDIS  (compose.infra.yaml, or the platform's own — the SAME Redis
# the plate/face modules and Django already talk to)
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# MINIO  (compose.infra.yaml, or the platform's own — the SAME MinIO
# the plate/face modules use; alert crops upload here)
# ---------------------------------------------------------------------
MINIO_PRIVATE_BUCKET=eyepass-private-bucket


# ---------------------------------------------------------------------
# MEDIAMTX / RTSP RELAY
# ---------------------------------------------------------------------
# Where fire_detector pulls frames from. This module bundles its own
# mediamtx/camera_stream (see compose.yaml) on ports offset from the
# plate/face modules' defaults so all three can run on one host without
# a collision. Point MTX_RTSP_BASE_URL at an EXISTING relay instead if
# this deployment already runs one shared by every module.



# =====================================================================
# CAMERA-STREAM SERVICE (camera_stream)
# =====================================================================
MONITOR_IDLE_SLEEP_SEC=1.0

# ---- debug output (local bind volume — never MinIO) ---------------------
CAMERA_DEBUG_HOST_DIR=./debug_camera


# =====================================================================
# TEST VIDEO PUBLISHERS (--profile test-video only)
# =====================================================================
# Put a local test clip next to this .env and point TEST_VIDEO_FILE at
# it — every video_publisher_N service loops the SAME file into its
# own camera id (1, 2, 3 — add more service blocks in compose.yaml for
# more). See README "Testing without real cameras".


# =====================================================================
# DETECTOR SERVICE (fire_detector)
# =====================================================================

# ---- image ----------------------------------------------------------
# The GPU-enabled base image with torch/ultralytics/opencv already
# installed — the SAME image the plate and face detectors build from.
# Swap this without touching any code.
AI_BASE_IMAGE=base_image_gpu:latest

DETECTOR_API_PORT=8012     # host

# ---- compute ----------------------------------------------------------
# auto | cpu | cuda | cuda:N — resolved per engine subprocess.
DETECTION_DEVICE=auto
# false => a requested-but-missing GPU logs a loud error and falls back
#          to CPU. true => that's a startup failure instead. Flip to
#          true once DETECTION_DEVICE is pinned to a real GPU.
STRICT_DEVICE=false
# Torch CPU threads per engine process (only matters on CPU with
# several engines — otherwise each grabs every core and they fight).
TORCH_NUM_THREADS=0
GPU_COUNT=1

# Operator-supplied: put best.pt in this folder.
DETECTION_MODELS_DIR=./models/detection
DETECTION_MODEL_PATH=/models/best.pt
DETECTION_IMG_SIZE=640
DETECTION_CONF_THRESHOLD=0.25

# ---- engine topology / self-healing ------------------------------------
MAX_CAMERAS_PER_ENGINE=6
DEFAULT_ENGINE_COUNT=1
ENGINE_REBALANCE_INTERVAL_SEC=30
ENGINE_SHUTDOWN_TIMEOUT_SEC=30

# ---- camera health ------------------------------------------------------
HEARTBEAT_TIMEOUT_SEC=15
CAMERA_OFFLINE_GRACE_SECONDS=10

# ---- internal-processing-error auto-restart -----------------------------
ERROR_RESTART_MAX_RETRIES=1
ERROR_RESTART_DELAY_SEC=3
ERROR_RESTART_COUNTER_RESET_AFTER_SEC=600

# ---- spatial-grid threat verification (2x2 regions per camera) ---------
# Rolling per-region window (frames) the FIRE/SMOKE/BOTH/CLEAR verdict
# is voted over.
GRID_WINDOW_SIZE=30
# Matching frames within the window needed before a region latches
# from CLEAR to a threat state (and fires a THREAT event).
GRID_VERIFY_THRESHOLD=22
# Consecutive fully-clear frames required before an escalated region
# is allowed to resolve back to CLEAR (and fire a RESOLUTION event).
GRID_COOLDOWN_FRAMES=90

# ---- RTSP reader --------------------------------------------------------
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RTSP_FFMPEG_STIMEOUT_US=5000000
RTSP_RECONNECT_BACKOFF_SEC=0.2
RTSP_READ_FAIL_BACKOFF_SEC=0.5
RTSP_READER_JOIN_TIMEOUT_SEC=2.0

# ---- engine loop / heartbeat --------------------------------------------
SLOW_BATCH_WARN_MS=150.0
PIPELINE_STATS_LOG_INTERVAL_SEC=5.0
HEARTBEAT_INTERVAL_SEC=10
HEARTBEAT_TTL_SEC=30

# ---- debug output (local bind volume — never MinIO) ---------------------
# Annotated video (bbox + 2x2 grid + region verdicts) written under the
# detector's /debug bind mount. Expensive — leave off unless you're
# actively eyeballing detections.
DETECTOR_DEBUG_VIDEO_ENABLED=false
DEBUG_VIDEO_HOST_DIR=./debug_video
DEBUG_VIDEO_SEGMENT_SECONDS=240
DEBUG_VIDEO_FPS=12
DEBUG_VIDEO_MAX_SEGMENTS=12
DEBUG_VIDEO_SCALE=1.0
DEBUG_VIDEO_EVERY_N=1
DEBUG_VIDEO_CODEC=mp4v
DEBUG_VIDEO_EXT=.mp4
DEBUG_VIDEO_JSONL=true


# =====================================================================
# SHARED
# =====================================================================
# text | json — see common/firecore/logging_setup.py.
