# =====================================================================
# EyePass suite — SHARED settings (root .env)
# ---------------------------------------------------------------------
# Layered ON TOP of each module's own .env (face-service/.env, ...), so
# anything set here wins for every module. Keep only suite-wide values
# here; module tuning stays in the module's .env. Never put a module's
# own identity here (REDIS_MODULE, bucket names, ports of one module).
# =====================================================================

# ---- which modules run ------------------------------------------------
# Any combination of: face, plate, heatmap, fire
# Optional extras:    watchdog (autoheal), tools (Redis UIs), test-video
COMPOSE_PROFILES=face,plate,heatmap,fire

# ---- general ------------------------------------------------------------
TZ=UTC
LOG_LEVEL=INFO
LOG_FORMAT=text
IMAGE_TAG=dev
SHARED_NETWORK=eyeplate_net

# ---- Redis (one for the whole suite) --------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_PUBLISH_PORT=6379

# ---- MinIO (one for the whole suite) --------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PROD
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SECURE=False
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001
# every module's bucket — created once by minio_init
MINIO_BUCKETS=face-private-bucket,face-public-bucket,face-heatmap,eyepass-private-bucket,eyepass-public-bucket,heatmap-data

# ---- the one camera relay + camera manager ---------------------------------
MTX_RTSP_BASE_URL=rtsp://mediamtx:8554
# source: one relay path per physical camera ("cam_<sha1(address)>"),
# shared by every module that uses it. Leave as is in the suite.
RELAY_PATH_MODE=source
# what the backend puts in front of a relay path for live view (WebRTC)
STREAM_BASE_URL=http://localhost:8889
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_ICE_UDP_PORT=8189
HLS_PORT=8888
MTX_API_PORT=9997
RTMP_PORT=1935
OFFLINE_HOLD_SECONDS=10
TRUST_MTX_ONLY=true
CAMERA_RTSP_PORT=554
CAMERA_SNAPSHOT_DEBUG_ENABLED=false

# ---- test-video profile ------------------------------------------------------
TEST_VIDEO_FILE_1=./test-video/video1.mp4
TEST_VIDEO_FILE_2=./test-video/video1.mp4
TEST_VIDEO_FILE_3=./test-video/video1.mp4
