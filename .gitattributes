# Shell scripts and Dockerfiles run inside Linux containers: always LF,
# even when checked out on Windows (CRLF breaks "#!/bin/sh").
*.sh            text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env*          text eol=lf
*.py           text eol=lf
*.md           text eol=lf
