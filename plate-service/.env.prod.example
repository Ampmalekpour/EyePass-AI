# =====================================================================
# EyePlate — Plate module — PRODUCTION
# ---------------------------------------------------------------------
#   cp .env.prod.example .env
#   then replace EVERY [FILL_IN] (search for it) with the platform's value.
#
# Production runs ONLY plate_detector + plate_ocr + control_hub. The
# platform provides Redis, MinIO and the shared RTSP relay
# (mediamtx + camera_stream); this module does not start its own.
# All other settings are in each service's config.py.
# =====================================================================

# ---------------------------------------------------------------------
# WHAT RUNS
# ---------------------------------------------------------------------
# GPU host: compose.yaml:compose.gpu.yaml      CPU host: compose.yaml
COMPOSE_FILE=compose.yaml:compose.gpu.yaml
COMPOSE_PATH_SEPARATOR=:
# empty = no standalone relay, no test clips (add "watchdog" for autoheal)
COMPOSE_PROFILES=

# ---------------------------------------------------------------------
# DEVICE / MODELS   (decided by us, not the backend)
# ---------------------------------------------------------------------
DETECTION_DEVICE=gpu                 # gpu | cpu   (match COMPOSE_FILE)
DETECTION_GPU_MODEL=plate_v8n_480    # plate_v8n_480 | plate_v8s_640
DETECTION_CPU_MODEL=openvino_fp32    # openvino_fp32 | openvino_int8 | onnx
CAPACITY_AUTO_DEGRADE=true           # CPU: lower the per-camera detection rate when over capacity | false = warn only
OCR_DEVICE=cpu                       # cpu | gpu

# ---------------------------------------------------------------------
# FOLDERS on the production host
# ---------------------------------------------------------------------
DETECTION_MODELS_DIR=./models/detection
OCR_MODELS_DIR=./models/ocr
DEBUG_VIDEO_HOST_DIR=./debug_video
OCR_DEBUG_HOST_DIR=./debug_ocr
CAMERA_DEBUG_HOST_DIR=./debug_camera

# ---------------------------------------------------------------------
# PLATFORM   (backend / DevOps)
# ---------------------------------------------------------------------
TZ=Asia/Tehran
# the docker network the platform's Redis, MinIO and mediamtx are on
SHARED_NETWORK=[FILL_IN]
IMAGE_TAG=[FILL_IN]
AI_BASE_IMAGE=base_image_gpu:latest
OCR_BASE_IMAGE=base_image_gpu:latest
GPU_COUNT=1
INSTALL_CPU_RUNTIMES=true
OPENVINO_VERSION=[FILL_IN]           # exact version the models were exported/benchmarked with
ONNXRUNTIME_VERSION=[FILL_IN]
DETECTOR_CPU_LIMIT=0
OCR_CPU_LIMIT=0

# ---------------------------------------------------------------------
# REDIS — the SAME Redis the backend (Django) and camera_stream use
# ---------------------------------------------------------------------
REDIS_MODULE=plate                   # do not change (backend key contract)
REDIS_HOST=[FILL_IN]                 # Redis container / host name
REDIS_PORT=[FILL_IN]                 # usually 6379
REDIS_DB=[FILL_IN]                   # usually 0
REDIS_PASSWORD=[FILL_IN]             # empty if none
REDIS_URL=[FILL_IN]                  # redis://:<password>@<host>:<port>/<db>  (wins over the 4 above)

# ---------------------------------------------------------------------
# MINIO — the platform's object storage (plate / vehicle images)
# ---------------------------------------------------------------------
MINIO_ENDPOINT=[FILL_IN]             # e.g. http://<minio container>:9000
MINIO_ROOT_USER=[FILL_IN]            # access key
MINIO_ROOT_PASSWORD=[FILL_IN]        # secret key
MINIO_SECURE=[FILL_IN]               # true | false
MINIO_REGION=us-east-1
MINIO_PRIVATE_BUCKET=[FILL_IN]       # e.g. eyepass-private-bucket
MINIO_PUBLIC_BUCKET=[FILL_IN]        # e.g. eyepass-public-bucket
MINIO_PUBLIC_URL=[FILL_IN]           # URL the frontend uses to reach MinIO

# ---------------------------------------------------------------------
# RTSP RELAY — the system's mediamtx (path name = camera id)
# ---------------------------------------------------------------------
MTX_RTSP_BASE_URL=[FILL_IN]          # rtsp://<system mediamtx container>:8554

# ---------------------------------------------------------------------
# HOST PORTS (change only if they clash on the host)
# ---------------------------------------------------------------------
DETECTOR_API_PORT=8010
OCR_API_PORT=8011
HUB_API_PORT=8021
