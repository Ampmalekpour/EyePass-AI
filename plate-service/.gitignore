# model weights — operator-supplied, not source
models/detection/*
models/ocr/*
!models/detection/.gitkeep
!models/ocr/.gitkeep

# debug output (local bind mounts, never meant to be committed)
debug_video/
debug_camera/
debug_ocr/

# python
__pycache__/
*.pyc

# local test videos fed to video_publisher (test-video profile) — operator
# supplied, not source; e.g. test_video.mp4, video2.mp4
*.mp4

# env (keep .env.example, not the real .env with secrets)
.env