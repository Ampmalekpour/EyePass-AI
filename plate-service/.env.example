# =====================================================================
# EyePlate — Plate module — STAGING / TEST (same platform services, own values)
# ---------------------------------------------------------------------
#   cp .env.example .env
#   Production: use .env.prod.example instead.
#   Replace EVERY [FILL_IN] below (search for "[FILL_IN]") with the
#   platform's value, then: docker compose up -d --build
#
# This module runs plate_detector + plate_ocr + control_hub only. The
# platform provides Redis, MinIO and the RTSP relay (mediamtx +
# camera_stream). Every other setting is in each service's config.py.
# =====================================================================

# ---------------------------------------------------------------------
# WHAT RUNS (read by docker compose)
# ---------------------------------------------------------------------
# GPU server: compose.yaml:compose.gpu.yaml   (needs NVIDIA driver + container toolkit, see DEPLOY_LINUX_GPU.md)
# CPU server: compose.yaml
COMPOSE_FILE=compose.yaml:compose.gpu.yaml
COMPOSE_PATH_SEPARATOR=:
# empty, or "watchdog" to add autoheal (restarts containers that turn unhealthy)
COMPOSE_PROFILES=

# ---------------------------------------------------------------------
# DEVICE / MODELS (set by the AI team)
# ---------------------------------------------------------------------
DETECTION_DEVICE=gpu                 # gpu | cpu   (must match COMPOSE_FILE)
DETECTION_GPU_MODEL=plate_v8n_480    # plate_v8n_480 | plate_v8s_640
DETECTION_CPU_MODEL=openvino_fp32    # openvino_fp32 | openvino_int8 | onnx
OCR_DEVICE=cpu                       # cpu | gpu
GPU_COUNT=1                          # GPUs reserved for plate_detector

# ---------------------------------------------------------------------
# FOLDERS on the server (relative to this folder, or absolute)
# ---------------------------------------------------------------------
DETECTION_MODELS_DIR=./models/detection
OCR_MODELS_DIR=./models/ocr
DEBUG_VIDEO_HOST_DIR=./debug_video
OCR_DEBUG_HOST_DIR=./debug_ocr

# ---------------------------------------------------------------------
# PLATFORM (backend / DevOps)
# ---------------------------------------------------------------------
TZ=Asia/Tehran
# Docker network that Redis, MinIO and mediamtx are attached to
SHARED_NETWORK=[FILL_IN]
IMAGE_TAG=dev
# base image with torch / ultralytics / OpenCV (docker load -i <file>.tar)
AI_BASE_IMAGE=[FILL_IN]              # e.g. base_image_gpu:latest
OCR_BASE_IMAGE=[FILL_IN]             # e.g. base_image_gpu:latest
# CPU inference runtimes baked into the detector image (AI team gives the exact versions)
INSTALL_CPU_RUNTIMES=true
OPENVINO_VERSION=[FILL_IN]
ONNXRUNTIME_VERSION=[FILL_IN]
# hard CPU limits per container (cores); 0 = unlimited
DETECTOR_CPU_LIMIT=0
OCR_CPU_LIMIT=0

# ---------------------------------------------------------------------
# REDIS — the SAME Redis that Django and camera_stream use
# ---------------------------------------------------------------------
REDIS_MODULE=plate                   # do not change (backend key contract: plate:*)
REDIS_HOST=[FILL_IN]                 # Redis container name on SHARED_NETWORK
REDIS_PORT=[FILL_IN]                 # usually 6379
REDIS_DB=[FILL_IN]                   # usually 0
REDIS_PASSWORD=[FILL_IN]             # leave empty if Redis has no password
REDIS_URL=[FILL_IN]                  # redis://:<password>@<host>:<port>/<db>  (wins over the 4 above)

# ---------------------------------------------------------------------
# MINIO (S3 API) — object storage for plate / vehicle images
# The code (common/platecore/minio_store.py) reads exactly these names;
# compose passes them through unchanged.
# ---------------------------------------------------------------------
MINIO_ENDPOINT=[FILL_IN]             # MinIO S3 API, e.g. http://<minio container>:9000
MINIO_ACCESS_KEY=[FILL_IN]           # access key with read + write on both buckets
MINIO_SECRET_KEY=[FILL_IN]           # secret key
MINIO_REGION=us-east-1               # MinIO's default region
MINIO_SECURE=[FILL_IN]               # true = https to MinIO | false
MINIO_VERIFY=false                   # true = verify MinIO's TLS certificate (only with MINIO_SECURE=true)
MINIO_PUBLIC_BUCKET=[FILL_IN]        # e.g. eyepass-public-bucket
MINIO_PRIVATE_BUCKET=[FILL_IN]       # e.g. eyepass-private-bucket (plate / vehicle images go here)
MINIO_PUBLIC_URL=[FILL_IN]           # base URL written into stored image links, e.g. http://<host>:9000

# ---------------------------------------------------------------------
# RTSP RELAY — the platform's mediamtx (path name = camera id)
# ---------------------------------------------------------------------
MTX_RTSP_BASE_URL=[FILL_IN]          # rtsp://<mediamtx container>:8554

# ---------------------------------------------------------------------
# CONTAINERS / OPERATIONS (safe defaults; change freely, no compose edit)
# ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=eyeplate-plate
DETECTOR_CONTAINER_NAME=plate_detector
OCR_CONTAINER_NAME=plate_ocr
HUB_CONTAINER_NAME=plate_control_hub
AUTOHEAL_CONTAINER_NAME=plate_autoheal
# image names (prefix with your registry if you push images, e.g. registry.local/eyeplate/plate-detector)
DETECTOR_IMAGE=eyeplate/plate-detector
OCR_IMAGE=eyeplate/plate-ocr
HUB_IMAGE=eyeplate/control-hub
# host IP the health/API ports listen on: 0.0.0.0 = all interfaces, 127.0.0.1 = this server only
HOST_BIND_IP=0.0.0.0
RESTART_POLICY=unless-stopped        # unless-stopped | always | on-failure | no
LOG_MAX_SIZE=20m                     # docker log rotation per container
LOG_MAX_FILE=5
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR  (empty = value in config.py)
LOG_FORMAT=text                      # text | json

# ---------------------------------------------------------------------
# HOST PORTS (health / API; change only if they clash on the server)
# ---------------------------------------------------------------------
DETECTOR_API_PORT=8010
OCR_API_PORT=8011
HUB_API_PORT=8021
