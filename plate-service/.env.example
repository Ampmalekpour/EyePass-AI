# =====================================================================
# EyePlate — Plate module (ALPR: detection + OCR) — DEVELOPMENT / TEST
# ---------------------------------------------------------------------
#   cp .env.example .env          (production: start from .env.prod.example)
#
# .env only decides WHICH device and model run, and WHERE things are
# (Redis, MinIO, the RTSP relay, ports, folders). Every other setting —
# thresholds, tracker, engines, logs, debug video — is in each service's
# config.py:
#     detector/src/config.py     ocr_service/src/config.py     control-hub/src/config.py
# =====================================================================

# ---------------------------------------------------------------------
# WHAT RUNS   (read by `docker compose` itself)
# ---------------------------------------------------------------------
# GPU host:  compose.yaml:compose.gpu.yaml   (adds the NVIDIA reservation)
# CPU host:  compose.yaml
COMPOSE_FILE=compose.yaml:compose.gpu.yaml
COMPOSE_PATH_SEPARATOR=:
# standalone-stream = this module's own mediamtx + camera_stream (dev / test).
#                     Remove it to use the system's shared streamer.
# test-video        = loop TEST_VIDEO_FILE into the relay as cameras 1..8
# watchdog          = autoheal
COMPOSE_PROFILES=standalone-stream

# ---------------------------------------------------------------------
# DETECTION — device and model
# ---------------------------------------------------------------------
# gpu | cpu | auto     (keep COMPOSE_FILE above in step)
DETECTION_DEVICE=gpu
# GPU model: plate_v8n_480 | plate_v8s_640          (folder in DETECTION_MODELS_DIR)
DETECTION_GPU_MODEL=plate_v8n_480
# CPU model: openvino_fp32 | openvino_int8 | onnx   (taken from the plate_v8n_480 folder)
DETECTION_CPU_MODEL=openvino_fp32

# ---------------------------------------------------------------------
# RECOGNITION (OCR) — device
# ---------------------------------------------------------------------
# cpu | gpu
OCR_DEVICE=cpu

# ---------------------------------------------------------------------
# FOLDERS (host paths, mounted into the containers)
# ---------------------------------------------------------------------
DETECTION_MODELS_DIR=./models/detection
OCR_MODELS_DIR=./models/ocr
DEBUG_VIDEO_HOST_DIR=./debug_video
OCR_DEBUG_HOST_DIR=./debug_ocr
CAMERA_DEBUG_HOST_DIR=./debug_camera

# ---------------------------------------------------------------------
# PLATFORM
# ---------------------------------------------------------------------
TZ=Asia/Tehran
# docker network every module attaches to (create once: docker network create eyeplate_net)
SHARED_NETWORK=eyeplate_net
IMAGE_TAG=dev
# base images (torch / ultralytics / OpenCV already installed)
AI_BASE_IMAGE=base_image_gpu:latest
OCR_BASE_IMAGE=base_image_gpu:latest
GPU_COUNT=1
# CPU runtimes baked into the detector image. PIN to the versions the
# models were exported + benchmarked with (pip freeze of that venv).
INSTALL_CPU_RUNTIMES=true
OPENVINO_VERSION=
ONNXRUNTIME_VERSION=
# hard CPU quotas (docker --cpus); 0 = unlimited
DETECTOR_CPU_LIMIT=0
OCR_CPU_LIMIT=0

# ---------------------------------------------------------------------
# REDIS  (compose.infra.yaml for dev, or the platform's Redis)
# ---------------------------------------------------------------------
# key prefix — must stay "plate" (backend contract: plate:cameras:config, ...)
REDIS_MODULE=plate
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_PUBLISH_PORT=6379

# ---------------------------------------------------------------------
# MINIO  (compose.infra.yaml for dev, or the platform's MinIO)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PRIVATE_BUCKET=eyepass-private-bucket
MINIO_PUBLIC_BUCKET=eyepass-public-bucket
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001

# ---------------------------------------------------------------------
# RTSP RELAY — where the detector reads frames: <MTX_RTSP_BASE_URL>/<camera_id>
# ---------------------------------------------------------------------
# standalone-stream profile: rtsp://mediamtx:8554
# system streamer:           rtsp://<system mediamtx container>:8554
MTX_RTSP_BASE_URL=rtsp://mediamtx:8554

# ---------------------------------------------------------------------
# HOST PORTS
# ---------------------------------------------------------------------
DETECTOR_API_PORT=8010
OCR_API_PORT=8011
HUB_API_PORT=8021
REDISINSIGHT_PORT=8001
REDIS_COMMANDER_PORT=8081
# standalone relay (profile standalone-stream)
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_ICE_UDP_PORT=8189
HLS_PORT=8888
MTX_API_PORT=9997
RTMP_PORT=1935

# ---------------------------------------------------------------------
# TEST VIDEO (profile test-video) — H.264 clip looped as cameras 1..8
# re-encode other codecs: ffmpeg -i in.mp4 -c:v libx264 -preset veryfast -an video2.mp4
# ---------------------------------------------------------------------
TEST_VIDEO_FILE=./video2.mp4
TEST_VIDEO_RTSP_BASE_URL=rtsp://mediamtx:8554
