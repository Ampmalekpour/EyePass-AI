# =====================================================================
# EyePlate — Plate module (ALPR: detection + OCR)
# ---------------------------------------------------------------------
#   cp .env.example .env
#
# .env is gitignored; THIS file is committed and is the reference for
# every variable the stack understands.
#
# Compose files:
#   compose.infra.yaml   redis + minio (+ inspection tools, --profile tools)
#                         — skip this if the platform already runs them
#   compose.yaml         plate_detector + plate_ocr + control_hub
#                         (+ standalone mediamtx/camera_stream, test clips,
#                          autoheal — each behind a profile)
#   compose.gpu.yaml     GPU reservation for plate_detector (GPU hosts only)
#
# Dev vs prod is not a different file — it's different VALUES in this
# file. Hostnames below are CONTAINER names; the *_PORT / *_PUBLISH_PORT
# values are the only ones a human or an IDE ever touches.
# =====================================================================

# ---------------------------------------------------------------------
# WHAT RUNS  (read by `docker compose` itself)
# ---------------------------------------------------------------------
# GPU or CPU host — keep this in step with DETECTION_DEVICE below:
#   GPU:  COMPOSE_FILE=compose.yaml:compose.gpu.yaml   + DETECTION_DEVICE=gpu
#   CPU:  COMPOSE_FILE=compose.yaml                    + DETECTION_DEVICE=cpu
COMPOSE_FILE=compose.yaml:compose.gpu.yaml
# ':' separates COMPOSE_FILE entries on every OS (Windows defaults to ';').
COMPOSE_PATH_SEPARATOR=:
# Optional parts, comma-separated:
#   standalone-stream  this module's OWN mediamtx + camera_stream. Remove it
#                      when the whole EyePass system's shared streamer is
#                      used instead (README "Using the system's streamer").
#   test-video         loop TEST_VIDEO_FILE into the relay as cameras 1..6
#   watchdog           autoheal
COMPOSE_PROFILES=standalone-stream

# ---------------------------------------------------------------------
# PLATFORM
# ---------------------------------------------------------------------
TZ=Asia/Tehran

# The shared docker network every module attaches to. Create it once:
#   docker network create eyeplate_net
SHARED_NETWORK=eyeplate_net

# Tag for built images. Use a git sha or semver once you have CI.
IMAGE_TAG=dev

# Redis key prefix owned by THIS module: every key becomes "<prefix>:...".
# Must stay "plate" to match the already-deployed backend/camera_stream
# contract (plate:cameras:config, plate:camera:events, etc.) — do not
# change this on an existing deployment without also migrating keys.
REDIS_MODULE=plate


# ---------------------------------------------------------------------
# REDIS  (compose.infra.yaml, or the platform's own — same Redis
# camera_stream and Django already talk to)
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
# host — published so redis_tools.py can run from your own machine.
REDIS_PUBLISH_PORT=6379


# ---------------------------------------------------------------------
# MINIO  (compose.infra.yaml, or the platform's own)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false
# Defaults match the EXISTING deployment's bucket names
# (docker-compose.standalone.yml) — do not rename without migrating.
MINIO_PRIVATE_BUCKET=eyepass-private-bucket
MINIO_PUBLIC_BUCKET=eyepass-public-bucket
# What Django/the frontend uses to resolve a stored key into a URL.
MINIO_PUBLIC_URL=http://localhost:9000
# host
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001


# ---------------------------------------------------------------------
# REDIS INSPECTION  (off by default: --profile tools)
# ---------------------------------------------------------------------
REDISINSIGHT_PORT=8001      # host — http://localhost:8001
REDIS_COMMANDER_PORT=8081   # host — http://localhost:8081


# ---------------------------------------------------------------------
# MEDIAMTX / RTSP RELAY
# ---------------------------------------------------------------------
# Where plate_detector pulls frames from: <this>/<camera_id>.
#   standalone-stream profile on: rtsp://mediamtx:8554 (this module's relay)
#   system streamer:  the system mediamtx's CONTAINER name on
#                     SHARED_NETWORK, e.g. rtsp://eyepass-mediamtx:8554
MTX_RTSP_BASE_URL=rtsp://mediamtx:8554


# =====================================================================
# CAMERA-STREAM SERVICE (camera_stream)
# =====================================================================
# How long an "offline" candidate must stay offline before it's really
# promoted/published — absorbs a network blip instead of flapping.
OFFLINE_HOLD_SECONDS=10
# true: "online" is decided purely from mediamtx's own ready state.
# false: also requires a raw TCP ping to succeed — stricter, more
# sensitive to transient blips.
TRUST_MTX_ONLY=true
CAMERA_RTSP_PORT=554
CAMERA_PING_TIMEOUT_SEC=0.2
MTX_POLL_INTERVAL_SEC=0.5
MTX_API_TIMEOUT_SEC=1.5
MONITOR_LOOP_INTERVAL_SEC=0.3
MONITOR_IDLE_SLEEP_SEC=1.0
REGISTER_CAMERA_TIMEOUT_SEC=1.0
REMOVE_FROM_MTX_TIMEOUT_SEC=1.0

# ---- debug output (local bind volume — never MinIO) ---------------------
CAMERA_DEBUG_HOST_DIR=./debug_camera
# Off by default; needs ffmpeg in camera-service's image (see its
# Dockerfile's commented-out apt-get line).
CAMERA_SNAPSHOT_DEBUG_ENABLED=false
CAMERA_SNAPSHOT_INTERVAL_SEC=60
CAMERA_SNAPSHOT_TIMEOUT_SEC=5


# =====================================================================
# DETECTOR SERVICE (plate_detector)
# =====================================================================

# ---- image ----------------------------------------------------------
# The GPU-enabled base image with torch/ultralytics/opencv already
# installed — same one the existing plate/Dockerfile built FROM
# (base_image_gpu:latest). Swap this without touching any code.
AI_BASE_IMAGE=base_image_gpu:latest

DETECTOR_API_PORT=8010     # host

# ---- CPU inference runtimes baked into the image -------------------------
# PIN these to the exact versions in `pip freeze` of the venv the models
# were exported and benchmarked with, then rebuild. The export and the
# runtime must use the same OpenVINO (re-export after an upgrade).
# Empty = latest (first try only). false = don't install (GPU-only image).
INSTALL_CPU_RUNTIMES=true
OPENVINO_VERSION=
ONNXRUNTIME_VERSION=

# ---- compute: GPU or CPU ---------------------------------------------------
#   gpu    GPU pipeline — PyTorch .pt through Ultralytics (unchanged)
#   cpu    CPU pipeline — DETECTION_BACKEND below (OpenVINO by default)
#   auto   gpu if CUDA is visible, else cpu
#   cuda:N a specific GPU
# Keep COMPOSE_FILE (top of this file) in step: GPU needs compose.gpu.yaml.
DETECTION_DEVICE=gpu
# false => a requested-but-missing GPU logs a loud error and falls back
#          to the CPU pipeline. true => that's a startup failure instead.
STRICT_DEVICE=false
# Torch CPU threads per engine process — only used when PyTorch itself
# runs on the CPU (DETECTION_BACKEND=pt or the fallback). 0 = auto.
TORCH_NUM_THREADS=0
GPU_COUNT=1

# ---- which model -------------------------------------------------------------
# Host folder bind-mounted at /models. Put in it (names matter):
#   plate_v8n_480.pt                       GPU (and CPU fallback)
#   plate_v8n_480_288x480.onnx             CPU, DETECTION_BACKEND=onnx
#   plate_v8n_480_fp32_openvino_model/     CPU, DETECTION_BACKEND=openvino
#   plate_v8n_480_int8_openvino_model/     CPU, DETECTION_PRECISION=int8
#   export_info.yaml                       input size + class names
#   plate_v8s_640.pt  (+ plate_v8s_640_* exports for CPU, see README)
DETECTION_MODELS_DIR=./models/detection
# The model to run: plate_v8n_480 | plate_v8s_640. Everything follows
# from this name — the file per backend AND the input size (480 / 640 on
# the GPU; the model's own static shape, e.g. 288x480, on the CPU).
DETECTION_MODEL=plate_v8n_480
# Leave empty. Only for an explicit file that doesn't follow the naming
# (in-container path, e.g. /models/best.pt).
DETECTION_MODEL_PATH=
# Leave 0 = follow the model (480 for *_480, 640 for *_640). Setting it
# runs the model at a non-native size.
DETECTION_IMG_SIZE=0
DETECTION_CONF_THRESHOLD=0.25
# Run YOLO on 1-in-N frames per camera; the tracker coasts the frames in
# between via its own Kalman prediction (dt-aware BYTETracker.update()).
# 1 = every frame, unchanged behavior. Raise this to fit more cameras per
# CPU engine (e.g. 3 = detect every 3rd frame, ~1/3 the inference cost).
# Keep cameras x fps / N under ~60-70% of the measured capacity.
DETECT_EVERY_N_FRAMES=1

# ---- CPU pipeline (DETECTION_DEVICE=cpu only; ignored on GPU) ------------------
# openvino (default: FP32, same detections as PyTorch, ~2x its speed)
# onnx     (ONNX Runtime; static input — see README for ROIs)
# pt       (Ultralytics/PyTorch on CPU — the old, slow path)
DETECTION_BACKEND=openvino
# fp32 (default) | int8 (openvino only; NOT accurate enough for plates
# yet — only after the INT8 accuracy gate in the README).
DETECTION_PRECISION=fp32
# Per-camera ROI shapes (openvino): roi = letterbox every ROI exactly like
# the GPU path does and compile the model once per ROI shape (needs an
# OpenVINO model converted from a dynamic ONNX — tools/export_cpu_models.py;
# a static one falls back to "fixed" with a warning). fixed = always the
# model's one static shape.
DETECTION_CPU_SHAPE_MODE=roi
# Empty = read the input shape from the model. "HxW" forces one (openvino
# reshape, multiples of 32).
DETECTION_CPU_INPUT_SIZE=
# Parallel requests per engine (OpenVINO NUM_STREAMS / ONNX sessions).
# 0 = cameras per engine (from CPU_EXPECTED_CAMERAS below) — set
# CPU_EXPECTED_CAMERAS to your real camera count.
DETECTION_CPU_STREAMS=0
# OpenVINO INFERENCE_NUM_THREADS per engine. 0 = auto: OpenVINO chooses
# with one engine (forcing the logical core count was 2x slower); cores
# are divided when several engines or CPU_CORES_OVERRIDE apply.
DETECTION_CPU_THREADS=0
# "" | PCORE_ONLY | ECORE_ONLY | ANY_CORE — try PCORE_ONLY if [STATS]
# shows infer p95 far above avg on a hybrid Intel CPU.
OPENVINO_SCHEDULING_CORE_TYPE=
# Compiled-model cache inside the container (faster restarts).
OPENVINO_CACHE_DIR=/data/openvino_cache
# NMS — Ultralytics' defaults; keep them so CPU == GPU detections.
DETECTION_IOU_THRESHOLD=0.7
DETECTION_MAX_DET=300
DETECTION_WARMUP_RUNS=3
# true: an ONNX/OpenVINO load failure logs an ERROR and runs the .pt model
# on CPU instead. false: the engine fails instead.
DETECTION_BACKEND_FALLBACK=true

# ---- engine topology / self-healing ------------------------------------
# A new engine subprocess is spawned past this many cameras.
MAX_CAMERAS_PER_ENGINE=6
# How many engines to bring up idle on a completely fresh boot (no
# self-healing checkpoint in Redis yet). After that, the persisted
# engine_count takes over automatically.
DEFAULT_ENGINE_COUNT=1
# How often EngineManager checks whether camera churn has fragmented
# cameras across more engines than necessary, and consolidates them.
ENGINE_REBALANCE_INTERVAL_SEC=30

# ---- CPU engine topology (device=="cpu" only; GPU always uses
# MAX_CAMERAS_PER_ENGINE above, unmodified) -- see detector/src/cpu_topology.py.
# With OpenVINO the recommended setup is CPU_ENGINE_MODE=single (ONE engine
# process for all cameras, one parallel request per camera) and
# CPU_EXPECTED_CAMERAS = your camera count.
#   single = current behavior: one engine batches cameras together into
#            one model.predict() call per loop iteration.
#   multi  = one engine PROCESS per camera (CPU_MULTI_CAMERAS_PER_ENGINE) --
#            same detection cadence/tracker settings, real OS-level
#            parallelism instead of in-process batching.
#   auto   = compute max_cameras_per_engine from core count + the measured
#            per-camera cost below, instead of a hand-set cap.
#
# CPU_MAX_CONCURRENT_ENGINES is the important one: how many engine
# PROCESSES this box can actually run in parallel without thrashing.
# Verify with `docker exec plate_detector nproc` -- a Docker `--cpus`
# limit is a CFS quota, not a cpuset, so os.cpu_count() inside the
# container can over-report vs. what Docker Desktop's Resources setting
# actually allows. Both "multi" and "auto" divide the torch thread pool
# by however many engines are expected to run concurrently (see
# CPU_EXPECTED_CAMERAS) -- get this wrong and every engine still tries
# to claim the full pool at once, which is what caused a 15x infer-time
# blowup (~40ms -> 600-700ms) the moment a 3rd single-camera engine
# started in an earlier version of this.
CPU_ENGINE_MODE=single
CPU_MAX_CONCURRENT_ENGINES=1
# Best estimate of how many cameras will end up attached -- used only to
# plan the thread split above, does not limit how many can be added.
CPU_EXPECTED_CAMERAS=1
# "multi" mode only: cameras per engine process (almost always 1). Torch
# thread count per engine is auto-divided from CPU_MAX_CONCURRENT_ENGINES/
# CPU_EXPECTED_CAMERAS; set CPU_MULTI_TORCH_THREADS > 0 to override that.
CPU_MULTI_CAMERAS_PER_ENGINE=1
CPU_MULTI_TORCH_THREADS=0
# "auto" mode only: cores held back for OS + camera capture threads.
CPU_RESERVE_CORES=1
# "auto" mode only: measured ms for ONE camera's forward pass at the
# current DETECTION_IMG_SIZE/model (read this from the detector's own
# [STATS] "infer avg" / batch_size log line, then re-measure after
# changing the image size, model, or CPU).
CPU_MS_PER_CAMERA_FRAME=28.0
# "auto" mode only: assumed camera input fps, for turning the ms estimate
# above into "how many cameras fit in one frame interval."
CAMERA_ASSUMED_FPS=25.0
# "auto" mode only: fraction of the frame interval budgeted to inference
# alone, leaving the rest for tracking/crop-harvesting/debug-video work.
CPU_AUTO_SAFETY_MARGIN=0.7

# os.cpu_count() inside the container reports the HOST's/VM's full
# logical core count, regardless of the DETECTOR_CPU_LIMIT quota below --
# a Docker `--cpus` quota throttles CPU-seconds, it does NOT change what
# the container can see. Leaving this unset while a quota (or sibling
# CPU-heavy services) is in play is what produces wild, bursty
# [INFER-SLOW] latencies (150ms one call, 1800ms the next, same
# single-image batch) instead of a clean slowdown -- the thread pool
# gets sized for cores the container never actually gets. ALWAYS set
# this to the same number as DETECTOR_CPU_LIMIT below.
CPU_CORES_OVERRIDE=0

# cv2's own thread pool (resize/crop/warp, used in ROI cropping and
# preprocessing) is SEPARATE from torch's -- torch_num_threads/
# CPU_CORES_OVERRIDE above have no effect on it. Left uncapped, OpenCV
# defaults to using every core it can see, same oversubscription failure
# as the torch-side one this file already guards against, just in a
# library nothing above touches. 0 = 2 on the openvino/onnx backends,
# or a small value derived from torch's thread count on the pt backend.
CV2_NUM_THREADS=0
# FFmpeg's OWN internal decode thread count, PER CAMERA STREAM -- also
# separate from torch/cv2 above. Unset, FFmpeg multi-threads its
# H.264/H.265 software decode across every core it can see, per camera,
# continuously -- real CPU demand nothing else here accounts for. 1-2 is
# plenty for one 1080p/25fps stream; 0 = FFmpeg's own default (all cores).
RTSP_FFMPEG_THREADS=1

# ---- hard CPU quotas (Docker-enforced, the real backstop) --------------
# These two are the actual fix for "one service starves everything else
# on the box" -- previously plate_detector and plate_ocr (3 PaddleOCR
# workers by default, OCR_USE_GPU=false) were BOTH unbounded and freely
# competed for every core with each other, mediamtx, the video
# publishers, and anything else on the host (backend, frontend, ...).
# Size these so DETECTOR_CPU_LIMIT + OCR_CPU_LIMIT + everything else
# fits comfortably under your real total core count -- e.g. on a 14-core
# box running 4 cameras: DETECTOR_CPU_LIMIT=6 OCR_CPU_LIMIT=4, leaving 4
# for mediamtx/camera_stream/publishers/redis/control_hub/backend/
# frontend/OS. Unset/0 = unlimited (prior behavior on both).
DETECTOR_CPU_LIMIT=0
OCR_CPU_LIMIT=0


# How long to wait for engine subprocesses to exit cleanly on shutdown.
# Must stay below plate_detector's stop_grace_period (60s) in compose.yaml.
ENGINE_SHUTDOWN_TIMEOUT_SEC=30

# ---- camera health ------------------------------------------------------
HEARTBEAT_TIMEOUT_SEC=15
# After a camera is reported/observed offline, wait this long before
# concluding it's really gone and detaching it — absorbs a camera
# that's merely mid-reconnect (a network blip should not churn its
# BYTETracker / in-flight tracks).
CAMERA_OFFLINE_GRACE_SECONDS=10

# ---- internal-processing-error auto-restart (existing plate behavior,
# ported verbatim from alpr_api.py's _attempt_processing_error_restart;
# distinct from the offline-grace path above — this is for an Engine's
# own internal error, not a physical disconnect) --------------------
ERROR_RESTART_MAX_RETRIES=1
ERROR_RESTART_DELAY_SEC=3
ERROR_RESTART_COUNTER_RESET_AFTER_SEC=600

# ---- trigger / track criteria (verbatim thresholds from video_processor.py)
MIN_TRACK_AGE_FOR_CROSSING=5
MIN_CONFIDENCE_FOR_CROSSING=0.40
CROSSING_COOLDOWN_FRAMES=30
ROI_ENTRY_CONFIRMATION_FRAMES=3
MIN_CONFIDENCE_FOR_ROI=0.35
STOP_TIME_SECONDS=3.0
STOP_VELOCITY_THRESHOLD=8.0
STOP_MIN_SAMPLES=10
# (OCR_CONF_SKIP_THRESHOLD / OCR_FINALIZE_TIMEOUT_SEC moved to the
#  control hub section below: PLATE_SATISFIED_CONF / PLATE_FINALIZE_TIMEOUT_SEC)

# ---- trigger history buffers (triggers.py's TriggerTrackState) --------
TRIGGER_POSITION_HISTORY_MAX=30
TRIGGER_CONFIDENCE_HISTORY_MAX=10
TRIGGER_VELOCITY_WINDOW=10

# ---- quality gates (verbatim thresholds from video_processor.py) ------
SHARPNESS_MIN_THRESHOLD=100.0
RESOLUTION_MIN_AREA=1000
CLASS_0_ASPECT_RATIO_MIN=1.5
CLASS_0_ASPECT_RATIO_MAX=7.5
GENERIC_ASPECT_RATIO_MIN=1.0
GENERIC_ASPECT_RATIO_MAX=5.5

# ---- track aggregation & buffers (verbatim) ----------------------------
DEFAULT_ABSENT_FRAMES=30
DEFAULT_MIN_SEEN_FRAMES=8
DEFAULT_MIN_CROPS_TO_FINALIZE=1
DEFAULT_N_BEST_CROPS=5
DEFAULT_CONF_DIGITS=2

# ---- tracker (BYTETracker / tracker.py's PlateTrackerConfig) ----------
# Full surface of the "FIX 1-7" enhancements — previously only
# track_buffer was reachable from .env; everything below matches
# PlateTrackerConfig's own hardcoded defaults exactly, so leaving all
# of this unset reproduces prior behavior bit-for-bit.
TRACKER_TRACK_THRESH=0.5
TRACKER_MATCH_THRESH=0.99
TRACKER_TRACK_BUFFER=60
TRACKER_NMS_THRESH=0.5
TRACKER_MOT20=false
TRACKER_SECOND_THRESH=0.5
TRACKER_DUPLICATE_THRESH=0.15
# young-track survival
TRACKER_PREDICT_UNCONFIRMED=true
TRACKER_UNCONFIRMED_THRESH=0.9
TRACKER_UNCONFIRMED_MAX_MISS=5
# new-track motion seeding
TRACKER_NEW_TRACK_VEL_STD_SCALE=3.0
TRACKER_SEED_VELOCITY_ON_FIRST_UPDATE=true
TRACKER_SEED_MAX_RATIO=1.5
TRACKER_RESEED_AFTER_GAP=3.0
# recovery pass for briefly-lost tracks
TRACKER_RECOVERY_ENABLED=true
TRACKER_RECOVERY_THRESH=0.7
TRACKER_RECOVERY_EXPANSION=0.5
TRACKER_RECOVERY_BASE_RADIUS=1.5
TRACKER_RECOVERY_RADIUS_GROWTH=0.4
TRACKER_RECOVERY_MAX_RADIUS=4.0
TRACKER_RECOVERY_SHAPE_WEIGHT=0.3
TRACKER_RECOVERY_CLASS_PENALTY=0.15
# GMC — camera-jolt/pan compensation
TRACKER_GMC_ENABLED=true
TRACKER_GMC_MIN_PAIRS=2
TRACKER_GMC_MAX_SHIFT_RATIO=0.25
TRACKER_MAX_REMOVED_HISTORY=512

# ---- RTSP reader --------------------------------------------------------
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RTSP_FFMPEG_STIMEOUT_US=5000000
RTSP_RECONNECT_BACKOFF_SEC=0.2
RTSP_READ_FAIL_BACKOFF_SEC=0.5
RTSP_READER_JOIN_TIMEOUT_SEC=2.0

# ---- engine loop / heartbeat --------------------------------------------
# A camera's batch taking longer than this logs an [INFER-SLOW] warning.
SLOW_BATCH_WARN_MS=150.0
PIPELINE_STATS_LOG_INTERVAL_SEC=5.0
HEARTBEAT_INTERVAL_SEC=10
HEARTBEAT_TTL_SEC=30

# ---- debug output (local bind volume — never MinIO) ---------------------
# Annotated video written under the detector's /debug bind mount.
# Expensive — leave off unless you're actively eyeballing detections.
DETECTOR_DEBUG_VIDEO_ENABLED=false
DEBUG_VIDEO_HOST_DIR=./debug_video
DEBUG_VIDEO_SEGMENT_SECONDS=240
DEBUG_VIDEO_FPS=12
DEBUG_VIDEO_MAX_SEGMENTS=12
DEBUG_VIDEO_SCALE=1.0
DEBUG_VIDEO_EVERY_N=1
DEBUG_VIDEO_CODEC=mp4v
DEBUG_VIDEO_EXT=.mp4
# Read directly by debug_recorder.py's own DebugConfig — see
# detector/src/config.py's Section 6 comment.
DEBUG_VIDEO_JSONL=true
DEBUG_VIDEO_GHOST_FRAMES=45
DEBUG_VIDEO_EVENT_LINES=14
DEBUG_VIDEO_TRAIL=30
DEBUG_VIDEO_PANEL_WIDTH=430

# New: a small labelled-grid JPEG saved every time a track is submitted
# to OCR — the fastest way to see exactly what crops went out, without
# scrubbing the full debug video. Off by default.
DEBUG_OCR_SUBMISSION_MONTAGE_ENABLED=false
DEBUG_OCR_SUBMISSION_MONTAGE_MAX_FILES=200


# =====================================================================
# OCR SERVICE (plate_ocr)
# =====================================================================

OCR_API_PORT=8011   # host

# The base image plate_ocr's Dockerfile builds from. As shipped this
# still defaults to the SAME heavy image plate_detector uses (see
# ocr_service/Dockerfile's header comment / DEBUGGING.md for why) —
# override once you've verified ocr_service/requirements.txt installs
# cleanly on a lighter, CPU-only base.
OCR_BASE_IMAGE=base_image_gpu:latest

# ---- models -----------------------------------------------------------
# Operator-supplied: the PaddleOCR model folders — see README "What you
# need to provide" for the exact subfolder/file names required.
OCR_MODELS_DIR=./models/ocr
OCR_USE_GPU=false
OCR_CONF_THRESHOLD=0.7
OCR_SAVE_ALL_CROPS=false
# CLAHE contrast preprocessing applied to car-plate crops before OCR —
# a real per-site tunable (lighting varies a lot), unlike the fixed
# model-input resize sizes next to it in worker.py.
OCR_CLAHE_CLIP_LIMIT=2.0
OCR_CLAHE_GRID_SIZE=8
# Motorcycle OCR discards detected text boxes smaller than this
# fraction of the largest box's area before voting.
OCR_MOTOR_MIN_BOX_AREA_RATIO=0.05

# ---- worker pool / self-healing ------------------------------------------
# How many worker subprocesses to bring up idle on a completely fresh
# boot (no self-healing checkpoint yet). After that, the persisted
# worker_count takes over automatically. OCR capacity is independent of
# detector engine count — scale this to your camera/vehicle volume, not
# to MAX_CAMERAS_PER_ENGINE.
OCR_DEFAULT_WORKER_COUNT=3
OCR_WORKER_LOAD_TIMEOUT_SEC=180
# Must stay below plate_ocr's stop_grace_period (45s) in compose.yaml.
OCR_WORKER_SHUTDOWN_TIMEOUT_SEC=30
# How often the pool watchdog checks for and respawns a crashed worker.
OCR_WATCHDOG_INTERVAL_SEC=5
OCR_IDLE_POLL_INTERVAL_SEC=0.2
OCR_TASK_POP_RETRY_BACKOFF_SEC=1.0
HEARTBEAT_INTERVAL_SEC=10
HEARTBEAT_TTL_SEC=30

# ---- debug output (local bind volume — never MinIO) ---------------------
OCR_DEBUG_HOST_DIR=./debug_ocr
# Structured one-line-per-task decision trace (queue latency, voted
# class, per-candidate confidences, winning vote, validation result).
LOG_DECISION_TRACE=true
# A small labelled-grid JPEG per finalized task showing the crop(s),
# every OCR candidate + confidence, and the final decision. Off by
# default — one JPEG per finalized task adds up on a busy deployment.
OCR_SAVE_DECISION_DEBUG=false
OCR_DECISION_DEBUG_MAX_FILES=200


# =====================================================================
# SHARED
# =====================================================================
LOG_LEVEL=INFO
# text | json — see common/platecore/logging_setup.py. json is meant
# for feeding a log aggregator without writing a second parser.
LOG_FORMAT=text

# =====================================================================
# CONTROL HUB (control_hub service — ./control-hub/README.md)
# Owns every track's OCR state: decides what is published and when.
# =====================================================================
HUB_API_PORT=8021
# "Good enough, stop asking": a VALID plate at this confidence ends
# re-querying for the track and publishes held triggers at once.
PLATE_SATISFIED_CONF=0.85
# ...or this many agreeing valid results with no disagreement (0 = off).
PLATE_CONSENSUS_MIN=3
# A trigger fired before the plate is known waits for the result of
# the task sent for it — up to TRIGGER_TASK_WAIT_SEC while that task is
# queued (a busy OCR delays the event instead of emptying it),
# or TRIGGER_MAX_WAIT_SEC when no crop could be sent at all.
PLATE_TRIGGER_MAX_WAIT_SEC=3.0
PLATE_TRIGGER_TASK_WAIT_SEC=15.0
# Periodic re-query cadence for cameras with the periodic flag
# (cond_per_trig). Previously ignored by the plate module.
PLATE_PERIODIC_INTERVAL_SEC=3.0
PLATE_PERIODIC_FIRST_DELAY_SEC=1.0
# After a track ends the final goes out as soon as every in-flight
# result (incl. the finalize pass) has landed — normally < 1s. This is
# only the upper bound, sized for a backlogged queue.
PLATE_FINALIZE_TIMEOUT_SEC=30.0
# Final record gate — a track shorter than this is dropped silently
# UNLESS something was already published for it.
PLATE_FINAL_MIN_SEEN_FRAMES=8
PLATE_FINAL_MIN_CROPS=1
# A track the hub stops hearing about (detector crash) is ended after:
PLATE_TRACK_STALE_SEC=120
# A result landing after the final (queue backlog beyond the timeout):
# republish_if_changed re-sends the final with revision+1 when it
# changes the answer (backend should upsert on track_uid); drop = log.
PLATE_LATE_RESULT_POLICY=republish_if_changed
PLATE_LATE_RESULT_GRACE_SEC=300

# ---- detector side of the hub contract ---------------------------------
# A submitted task blocks the next one for the same track until the hub
# acks its result, or this long at most.
SUBMIT_TIMEOUT_SEC=15.0
TRACK_UPDATE_INTERVAL_SEC=5.0

# =====================================================================
# TEST VIDEO (profile test-video)
# Loops a local clip into the relay as camera path "1" (publishers 2..6
# use paths "2".."6" with the same clip). The file must be H.264 (the
# publisher stream-copies it); re-encode other codecs with
#   ffmpeg -i in.mp4 -c:v libx264 -preset veryfast -an video2.mp4
# =====================================================================
TEST_VIDEO_FILE=./video2.mp4
# The relay the clips are published to: this module's standalone mediamtx
# by default; with the system streamer, its mediamtx container.
TEST_VIDEO_RTSP_BASE_URL=rtsp://mediamtx:8554

