# =====================================================================
# plate-service — CPU server (e.g. the Linux test box, 4 test cameras)
# ---------------------------------------------------------------------
# cp .env.cpu-server.example .env
# Everything here is read by `docker compose`; tuning lives in each
# service's config.py.
# =====================================================================
COMPOSE_FILE=compose.yaml:compose.infra.yaml
COMPOSE_PATH_SEPARATOR=:
# own relay + the looped test video (cameras 1..8; start only 1..4, see README)
COMPOSE_PROFILES=standalone-stream,test-video

# ---- detection: CPU -----------------------------------------------------
DETECTION_DEVICE=cpu
DETECTION_GPU_MODEL=plate_v8n_480
# openvino_int8 | openvino_fp32 | onnx   (models in ./models/detection/plate_v8n_480/)
DETECTION_CPU_MODEL=openvino_int8
CAPACITY_AUTO_DEGRADE=true
OCR_DEVICE=cpu

# ---- folders / platform ---------------------------------------------------
DETECTION_MODELS_DIR=./models/detection
OCR_MODELS_DIR=./models/ocr
DEBUG_VIDEO_HOST_DIR=./debug_video
OCR_DEBUG_HOST_DIR=./debug_ocr
CAMERA_DEBUG_HOST_DIR=./debug_camera
TZ=UTC
SHARED_NETWORK=eyeplate_net
IMAGE_TAG=dev

# ---- images: build once with docker/Dockerfile.base-cpu ---------------------
AI_BASE_IMAGE=base_image_cpu:latest
OCR_BASE_IMAGE=base_image_cpu:latest
GPU_COUNT=1
INSTALL_CPU_RUNTIMES=false      # the base image already has openvino + onnxruntime
OPENVINO_VERSION=
ONNXRUNTIME_VERSION=
DETECTOR_CPU_LIMIT=0
OCR_CPU_LIMIT=0

# ---- Redis / MinIO (compose.infra.yaml) ------------------------------------
REDIS_MODULE=plate
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_PUBLISH_PORT=6379
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PRIVATE_BUCKET=eyepass-private-bucket
MINIO_PUBLIC_BUCKET=eyepass-public-bucket
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001

# ---- RTSP relay ---------------------------------------------------------------
MTX_RTSP_BASE_URL=rtsp://mediamtx:8554

# ---- host ports ----------------------------------------------------------------
DETECTOR_API_PORT=8010
OCR_API_PORT=8011
HUB_API_PORT=8021
REDISINSIGHT_PORT=8001
REDIS_COMMANDER_PORT=8081
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_ICE_UDP_PORT=8189
HLS_PORT=8888
MTX_API_PORT=9997
RTMP_PORT=1935

# ---- test video (put the file in this folder; H.264) -----------------------------
TEST_VIDEO_FILE=./video2.mp4
TEST_VIDEO_RTSP_BASE_URL=rtsp://mediamtx:8554
