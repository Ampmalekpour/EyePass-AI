# =====================================================================
# base_image_cpu — CPU base image for plate-detector and plate-ocr
# ---------------------------------------------------------------------
# The operator's CPU Dockerfile + what the CPU pipeline needs:
#   * openvino      (openvino_fp32 / openvino_int8 models)
#   * onnxruntime   (onnx model; pinned, was floating)
# Build it ONCE on the server, from the plate-service folder:
#
#   docker build -f docker/Dockerfile.base-cpu -t base_image_cpu:latest .
#
# .env: AI_BASE_IMAGE=base_image_cpu:latest  OCR_BASE_IMAGE=base_image_cpu:latest
# The versions below are the ones the measured results came from
# (python 3.10, numpy 1.24.4, opencv 4.11, torch 1.13.1+cpu,
#  ultralytics 8.3.165, onnxruntime 1.23.2, openvino 2026.4.1).
# Export the OpenVINO models with the SAME openvino version.
# =====================================================================
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
# slow / flaky link to PyPI: long timeout + many retries (default is 15 s x 5)
ENV PIP_DEFAULT_TIMEOUT=180 PIP_RETRIES=15 PIP_DISABLE_PIP_VERSION_CHECK=1

# Upgrade pip and install Cython
RUN apt-get update && apt-get install -y python3 python3-pip python3-distutils python3-venv

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip
RUN python3 -m pip install cython

# Install dependencies with resume retries
RUN python3 -m pip install albumentations==2.0.8
RUN python3 -m pip install numpy==1.26.4
RUN python3 -m pip install opencv-contrib-python==4.10.0.84

RUN python3 -m pip install ultralytics==8.3.165

RUN python3 -m pip install paddleocr==2.9.0
RUN python3 -m pip install paddlepaddle==2.6.2     # GPU → CPU

RUN python3 -m pip install paddlex==3.1.3
RUN python3 -m pip install cython_bbox==0.1.5
RUN python3 -m pip install fastapi==0.116.1

RUN python3 -m pip install uvicorn==0.35.0

RUN python3 -m pip install loguru==0.7.3
RUN python3 -m pip install lap

RUN python3 -m pip install pyinstaller==6.10.0

#RUN python3 -m pip install --extra-index-url https://pypi.nvidia.com tensorrt-cu11==10.12.0.36

# Uninstall pre-installed opencv (if present)
RUN python3 -m pip uninstall -y opencv-python opencv || true
RUN rm -rf /usr/local/lib/python3.10/dist-packages/cv2 || true

RUN python3 -m pip uninstall -y torch torchvision || true

# Copy the local torch wheel file and install it along with torchvision and torchaudio

# Install dependencies with resume retries
RUN pip install --no-cache-dir onnxruntime==1.23.2
RUN pip install --no-cache-dir pytorch-lightning==1.8.6
RUN pip install --no-cache-dir tensorflow==2.10.0
RUN pip install --no-cache-dir tensorflow-estimator==2.10.0
RUN pip install --no-cache-dir tensorflow-io-gcs-filesystem==0.31.0
RUN pip install --no-cache-dir tensorboard
RUN pip install --no-cache-dir tensorboard-data-server
RUN pip install --no-cache-dir tensorboard-plugin-wit
RUN pip install --no-cache-dir tensorboardX
RUN pip install --no-cache-dir face-detection

# (GPU wheel removed → CPU install مستقیم)
RUN pip install torch==1.13.1+cpu torchvision==0.14.1+cpu torchaudio==0.13.1 --extra-index-url https://download.pytorch.org/whl/cpu
#RUN python3 -m pip install --no-cache-dir torch==1.13.1+cu117 torchvision==0.14.1+cu117 torchaudio==0.13.1+cu117 -f https://download.pytorch.org/whl/cu117/torch_stable.html

# Install specific NumPy version
RUN python3 -m pip install --force-reinstall numpy==1.26.4

# Install OpenCV and its dependency
RUN apt-get update && apt-get install -y libgl1-mesa-glx
RUN python3 -m pip install opencv-python==4.11.0.86


RUN python3 -m pip install --no-cache-dir setuptools==69.5.1
RUN python3 -m pip install --force-reinstall numpy==1.24.4
RUN python3 -m pip install --force-reinstall python-multipart

RUN python3 -m pip install --no-cache-dir redis
RUN python3 -m pip install --no-cache-dir boto3

RUN python3 -m pip install --no-cache-dir scikit-learn

# ---- CPU inference runtimes for the detector ---------------------------
RUN python3 -m pip install --no-cache-dir openvino==2026.4.1

# ---- build-time sanity check: fail the build, not the first start ------
RUN python3 -c "import openvino, onnxruntime, cv2, torch, numpy, ultralytics, paddle, redis, boto3; \
print('openvino', openvino.__version__, '| onnxruntime', onnxruntime.__version__, '| numpy', numpy.__version__, \
'| cv2', cv2.__version__, '| torch', torch.__version__, '| ultralytics', ultralytics.__version__)"
