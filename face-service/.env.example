# =====================================================================
# EyePlate — Face module (detection + recognition)
# ---------------------------------------------------------------------
#   cp .env.example .env
#
# .env is gitignored; THIS file is committed and is the reference for
# every variable the stack understands.
#
# Two compose files, no overlays:
#   compose.infra.yaml   redis + minio (+ inspection tools, --profile tools)
#   compose.yaml         mediamtx + face_detector + face_recognizer (+ autoheal, --profile watchdog)
#
# Dev vs prod is not a different file — it's different VALUES in this
# file. Hostnames below are CONTAINER names; the *_PORT / *_PUBLISH_PORT
# values are the only ones a human or an IDE ever touches.
#
# Every operational parameter the code reads — timeouts, thresholds,
# retry counts, debug toggles — has an env var here with the exact
# default that was previously hardcoded. Changing a value here changes
# runtime behaviour with no code edit and no rebuild (just a restart,
# or nothing at all for a bind-mounted service). See DEBUGGING.md for
# the full guide to the debug output these turn on.
# =====================================================================

# ---------------------------------------------------------------------
# PLATFORM
# ---------------------------------------------------------------------
TZ=Asia/Tehran

# The shared docker network every module attaches to. Create it once:
#   docker network create eyeplate_net
SHARED_NETWORK=eyeplate_net

# Tag for built images. Use a git sha or semver once you have CI.
IMAGE_TAG=dev

# Redis key prefix owned by THIS module: every key becomes "<prefix>:...".
# Don't change after go-live without migrating the existing keys.
REDIS_MODULE=face

# ---- debug output root (local bind volume — never MinIO) --------------
# Every section's visual/log debug output lands on the HOST under this
# one root, one subfolder per section, so nothing is hidden inside a
# docker-managed volume:
#   ${DEBUG_ROOT_HOST_DIR}/camera-service/   camera_status.log (+ optional snapshots)
#   ${DEBUG_ROOT_HOST_DIR}/detector/         annotated video, best-crop montages, liveness rejects
#   ${DEBUG_ROOT_HOST_DIR}/recognizer/       landmarked/aligned crops, match viz, add-face debug
# See DEBUGGING.md for the exact tree and what each file shows.
DEBUG_ROOT_HOST_DIR=./debug
# The detector's own bind mount target defaults to a subfolder of
# DEBUG_ROOT_HOST_DIR above; kept as its own variable only because it
# predates DEBUG_ROOT_HOST_DIR and some operators may want the
# detector's (usually much larger — video) debug output on a different
# disk/mount than the rest. Leave unset to just nest it under the root.
DEBUG_VIDEO_HOST_DIR=./debug/detector


# ---------------------------------------------------------------------
# REDIS  (compose.infra.yaml, or the platform's own — same Redis the
# heatmap module and any other AI module already talk to)
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
# host — published so redis_tools.py can run from your own machine.
REDIS_PUBLISH_PORT=6379


# ---------------------------------------------------------------------
# MINIO  (compose.infra.yaml, or the platform's own)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PROD
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false
# The two buckets this module uses — pipeline data only. Debug output
# never touches MinIO (see DEBUGGING.md's storage split).
MINIO_PRIVATE_BUCKET=face-private-bucket
MINIO_PUBLIC_BUCKET=face-public-bucket
# What a browser/backend uses to resolve a stored key into a URL.
MINIO_PUBLIC_URL=http://localhost:9000
# host
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001


# ---------------------------------------------------------------------
# REDIS INSPECTION  (off by default: --profile tools)
# ---------------------------------------------------------------------
REDISINSIGHT_PORT=8001      # host — http://localhost:8001
REDIS_COMMANDER_PORT=8081   # host — http://localhost:8081


# ---------------------------------------------------------------------
# MEDIAMTX  (RTSP relay)
# ---------------------------------------------------------------------
MEDIAMTX_TAG=latest
RTSP_PORT=8554            # host
WEBRTC_PORT=8889          # host
WEBRTC_ICE_UDP_PORT=8189  # host, UDP — required for WebRTC playback
HLS_PORT=8888             # host
RTMP_PORT=1935            # host
MTX_API_PORT=9997         # host — no auth; keep firewalled from outside your network
MTX_LOGLEVEL=info         # set to `debug` while chasing a connection issue

STREAM_BASE_URL=http://localhost:8889
MTX_APIADDRESS=:9997
MTX_RTSPADDRESS=:8554
MTX_WEBRTCADDRESS=:8889
MTX_HLSADDRESS=:8888

# Where the detector pulls frames from — the relay's container name.
# If you point this at an already-running SHARED relay instead of the
# mediamtx service in compose.yaml, delete that service block.
MTX_RTSP_BASE_URL=rtsp://mediamtx:8554


# ---------------------------------------------------------------------
# CAMERA_STREAM  (camera_stream service in compose.yaml — registers
# cameras with MediaMTX, watches health, publishes face:cameras:*)
# ---------------------------------------------------------------------
OFFLINE_HOLD_SECONDS=10
CAMERA_STREAM_DEBUG=false

# ---- operational tunables (all previously hardcoded in main.py — see
# that file's own comments for exactly which literal each one replaces)
TRUST_MTX_ONLY=true
CAMERA_RTSP_PORT=554
CAMERA_PING_TIMEOUT_SEC=0.2
MTX_POLL_INTERVAL_SEC=0.5
MONITOR_LOOP_INTERVAL_SEC=0.3
MTX_API_TIMEOUT_SEC=1.5
REGISTER_CAMERA_TIMEOUT_SEC=1.0
REMOVE_FROM_MTX_TIMEOUT_SEC=1.0

# ---- debug output (local bind volume — never MinIO) --------------------
# Off by default — needs ffmpeg added to camera-service/Dockerfile (one
# commented-out line there). See DEBUGGING.md.
CAMERA_SNAPSHOT_DEBUG_ENABLED=false
CAMERA_SNAPSHOT_INTERVAL_SEC=60
CAMERA_SNAPSHOT_TIMEOUT_SEC=5
CAMERA_SNAPSHOT_MAX_PER_CAMERA=20


# =====================================================================
# DETECTOR SERVICE (face_detector)
# =====================================================================

# ---- image ----------------------------------------------------------
# You already have this locally: `docker images | grep base_image`.
# Swap this for the backend's own base without touching any code — just
# this one line. Both face_detector and face_recognizer build from it.
AI_BASE_IMAGE=base_image:latest

DETECTOR_API_PORT=8010     # host

# ---- compute ----------------------------------------------------------
# auto | cpu | cuda | cuda:N — resolved per engine subprocess.
DETECTION_DEVICE=auto
# false => a requested-but-missing GPU logs a loud error and falls back
#          to CPU. true => that's a startup failure instead. Flip to
#          true once DETECTION_DEVICE is pinned to a real GPU.
STRICT_DEVICE=false
# Torch CPU threads per engine process (only matters on CPU with several
# engines — otherwise each grabs every core and they fight).
TORCH_NUM_THREADS=0
GPU_COUNT=1

# Operator-supplied: put best1.pt in this folder.
DETECTION_MODELS_DIR=./models/detection
DETECTION_MODEL_PATH=/models/best1.pt
DETECTION_IMG_SIZE=800
DETECTION_CONF_THRESHOLD=0.25

# ---- engine topology / self-healing ------------------------------------
# A new engine subprocess is spawned past this many cameras.
MAX_CAMERAS_PER_ENGINE=6
# How many engines to bring up idle on a completely fresh boot (no
# self-healing checkpoint in Redis yet). After that, the persisted
# engine_count takes over automatically.
DEFAULT_ENGINE_COUNT=1
# How often EngineManager checks whether camera churn has fragmented
# cameras across more engines than necessary, and consolidates them.
ENGINE_REBALANCE_INTERVAL_SEC=30
# How long to wait for engine subprocesses to exit cleanly on shutdown.
# Must stay below face_detector's stop_grace_period (60s) in compose.yaml.
ENGINE_SHUTDOWN_TIMEOUT_SEC=30

# ---- camera health ------------------------------------------------------
HEARTBEAT_TIMEOUT_SEC=15
# After a camera is reported/observed offline, wait this long before
# concluding it's really gone and tearing its engine assignment down —
# absorbs a camera that's merely mid-reconnect.
CAMERA_OFFLINE_GRACE_SECONDS=30

# ---- legacy raw-frame dump (local bind volume — never MinIO) ----------
# Written under /debug/legacy_raw_output. Expensive — leave off unless
# you're actively eyeballing raw detections outside the annotated video
# below.
DETECTOR_SAVE_OUTPUT=false
DETECTOR_SAVE_AS_VIDEO=true
LEGACY_VIDEO_FPS=20

# ---- annotated debug video (debug_recorder.py) -------------------------
# Rolling per-camera MP4 showing detections, tracks, landmarks, pose,
# crop quality, liveness verdict and the recognition round-trip time.
# Lands on the host under DEBUG_VIDEO_HOST_DIR (see PLATFORM section).
# See DEBUGGING.md for what every HUD line means.
DEBUG_VIDEO_ENABLED=true
DEBUG_VIDEO_SEGMENT_SECONDS=30
DEBUG_VIDEO_FPS=12
DEBUG_VIDEO_MAX_SEGMENTS=40
DEBUG_VIDEO_SCALE=1.0
DEBUG_VIDEO_EVERY_N=1
DEBUG_VIDEO_JSONL=true
DEBUG_VIDEO_PANEL_WIDTH=430
DEBUG_VIDEO_CODEC=mp4v
DEBUG_VIDEO_GHOST_FRAMES=45
DEBUG_VIDEO_EVENT_LINES=14
DEBUG_VIDEO_DRAW_LANDMARKS=true

# ---- best-crop montage + liveness-reject stills (debug_extras.py) -----
# Both off by default — see DEBUGGING.md for what each shows.
DEBUG_BEST_CROP_MONTAGE_ENABLED=false
DEBUG_BEST_CROP_MONTAGE_MAX_FILES=200
DEBUG_LIVENESS_REJECTS_ENABLED=false
DEBUG_LIVENESS_REJECTS_MAX_FILES=200

# ---- tracker (BYTETracker) — defaults reproduce prior hardcoded
# behaviour exactly (track_buffer was 35 at the call site, NOT the
# class's own default of 90 — see engine.py's comments) --------------
TRACKER_TRACK_THRESH=0.5
TRACKER_MATCH_THRESH=0.9
TRACKER_TRACK_BUFFER=35
TRACKER_NMS_THRESH=0.5
TRACKER_MOT20=true

# ---- geometry thresholds (previously hardcoded literals in engine.py) -
LANDMARK_VALID_CONF_THRESHOLD=0.2
YAW_GROUP_FRONTAL_MAX_DEG=15
YAW_GROUP_QUARTER_MAX_DEG=30

# ---- liveness / presentation-attack detection -----------------
# Non-DL anti-spoofing (photo / phone / monitor held to the camera).
# Verdict rides on the track into the recognition task and into
# ai:results. See detector/src/liveness.py; calibrate the thresholds
# with detector/src/calibrate_liveness.py.
LIVENESS_ENABLED=true
LIVENESS_EVAL_EVERY_N_FRAMES=3
LIVENESS_MIN_POSE_DELTA_DEG=10
LIVENESS_PLANAR_RESIDUAL_THR=0.006
LIVENESS_RING_FOLLOW_THR=0.60
LIVENESS_RIGID_RESIDUAL_THR=0.004
LIVENESS_MIN_EVALS=3


# =====================================================================
# RECOGNIZER SERVICE (face_recognizer)
# =====================================================================

RECOGNIZER_API_PORT=8011   # host

# ---- models -----------------------------------------------------------
# ONNX is the primary backend; PyTorch is only the fallback if ONNX
# fails to load. Operator-supplied, see README "What you need to provide".
RECOGNITION_MODELS_DIR=./models/recognition          # adaface_ir50_cpu.onnx goes here
RECOGNITION_PRETRAINED_DIR=./recognizer/pretrained    # adaface_ir50_ms1mv2.ckpt + warmup.jpg
FACE_ALIGNMENT_DIR=./recognizer/face_alignment        # the face_alignment package

USE_ONNX=true
RECOGNITION_MODEL_NAME=ir_50
ONNX_MODEL_PATH=/models/adaface_ir50_cpu.onnx
PYTORCH_MODEL_PATH=pretrained/adaface_ir50_ms1mv2.ckpt
WARMUP_IMAGE_PATH=pretrained/warmup.jpg

# ---- gallery (pipeline data — MinIO) -------------------------------------
GALLERY_MINIO_PREFIX=dynamics/CTDBUR/
GALLERY_DB_MINIO_KEY=dynamics/CTDBUR/brieface.db
# Local folder the one-shot gallery_seed service mirrors into MinIO at
# startup (brieface.db + reference images, flat). Not used by the
# recognizer itself — only by gallery_seed.
RECOGNITION_GALLERY_DIR=./recognizer/gallery

# ---- worker pool / self-healing ------------------------------------------
# How many worker subprocesses to bring up idle on a completely fresh
# boot (no self-healing checkpoint yet). After that, the persisted
# worker_count takes over automatically. Recognition capacity is
# independent of detector engine count — scale this to your camera/face
# volume, not to MAX_CAMERAS_PER_ENGINE.
DEFAULT_WORKER_COUNT=2
WORKER_LOAD_TIMEOUT_SEC=180
# Must stay below face_recognizer's stop_grace_period (45s) in compose.yaml.
WORKER_SHUTDOWN_TIMEOUT_SEC=30
# How often the pool watchdog checks for and respawns a crashed worker.
WATCHDOG_INTERVAL_SEC=5

# ---- performance ----------------------------------------------------------
USE_BATCHING=true
BATCH_SIZE=16
# ONNXRuntime session threading + warmup — previously hardcoded in
# recognition_engine.py.
ONNX_INTRA_OP_THREADS=4
ONNX_INTER_OP_THREADS=2
ONNX_WARMUP_ITERATIONS=3
# Retry behaviour for the periodic embeddings .pkl checkpoint save.
PKL_SAVE_MAX_RETRIES=3
PKL_SAVE_RETRY_DELAY_SEC=0.5

# ---- decision-math overrides ------------------------------------------
# The tsallis-confidence decision itself (top_k, tau, alpha, up/mid/down
# thresholds) lives in config.py's DECISION_TOP_K / TSALLIS_TAU /
# REC_*_THR — already env-configurable there. These three are the
# confidence-penalty knobs around it. Defaults below reproduce the
# EXACT prior hardcoded behaviour in recognition_engine.py — this math
# is documented there as "must not drift"; only change these if you
# mean to.
HIGH_CONFIDENCE_RAW_SCORE_THR=0.6
CONF_PENALTY_HIGH_LOW_RAW=0.6667
CONF_PENALTY_MID=0.5

# ---- debug output (local bind volume — never MinIO) -----------------------
# /data is a HOST BIND MOUNT under DEBUG_ROOT_HOST_DIR/recognizer (see
# PLATFORM section) — everything below is directly browsable on disk.
# Pipeline artifacts (crops, frames, the gallery db) still go to MinIO
# only — never here. See DEBUGGING.md for the full folder tree.
DEBUG_SAVE_LANDMARKED_CROPS=true
DEBUG_SAVE_ALIGNED=true
DEBUG_LANDMARKED_MAX_FILES=500
DEBUG_ALIGNED_MAX_FILES=500

# crop -> aligned -> top-K gallery matches, one composite per decision.
# Off by default — expensive to leave on in production (one image write
# per recognition), turn on while investigating a specific camera/person.
DEBUG_SAVE_MATCHES=false
DEBUG_MATCHES_TOP_N=5
DEBUG_MATCHES_MAX_FILES=500
# Same idea, but for Unknown verdicts — helps spot a gallery gap vs. a
# genuinely unrecognized face.
DEBUG_SAVE_REJECTED=false
DEBUG_REJECTED_MAX_FILES=500

# add-face / enrollment debug (pose-check overlays + the final 3-photo
# enrollment card) — ON by default, since enrollment is low-volume and
# these are the images support most often needs. See DEBUGGING.md.
DEBUG_ENROLL_ENABLED=true
DEBUG_ENROLL_MAX_FILES=500

# Per-decision structured trace (top-K raw similarities, fused scores,
# tsallis confidence before/after penalty, which penalty fired, the
# thresholds compared against) — logged at DEBUG level only, so it costs
# nothing unless LOG_LEVEL=DEBUG. See DEBUGGING.md "Reading the decision
# trace".
LOG_DECISION_TRACE=true


# =====================================================================
# CONTROL HUB (control_hub service — ./control-hub/README.md)
# Owns every track's recognition state: decides what is published and when.
# =====================================================================
HUB_API_PORT=8020
# "Good enough, stop asking": a VALID identity at this confidence ends
# re-querying for the track and publishes held triggers at once.
FACE_SATISFIED_CONF=0.70
# ...or this many agreeing valid results with no disagreement (0 = off).
FACE_CONSENSUS_MIN=3
# A trigger fired before the identity is known waits for the result of
# the task sent for it — up to TRIGGER_TASK_WAIT_SEC while that task is
# queued (a busy recognizer delays the event instead of emptying it),
# or TRIGGER_MAX_WAIT_SEC when no crop could be sent at all.
FACE_TRIGGER_MAX_WAIT_SEC=3.0
FACE_TRIGGER_TASK_WAIT_SEC=15.0
# Periodic re-query cadence for cameras with the periodic flag
# (cond_per_trig).
FACE_PERIODIC_INTERVAL_SEC=3.0
FACE_PERIODIC_FIRST_DELAY_SEC=1.0
# After a track ends the final goes out as soon as every in-flight
# result (incl. the finalize pass) has landed — normally < 1s. This is
# only the upper bound, sized for a backlogged queue.
FACE_FINALIZE_TIMEOUT_SEC=30.0
# Final record gate — a track shorter than this is dropped silently
# UNLESS something was already published for it.
FACE_FINAL_MIN_SEEN_FRAMES=8
FACE_FINAL_MIN_CROPS=1
# A track the hub stops hearing about (detector crash) is ended after:
FACE_TRACK_STALE_SEC=120
# A result landing after the final (queue backlog beyond the timeout):
# republish_if_changed re-sends the final with revision+1 when it
# changes the answer (backend should upsert on track_uid); drop = log.
FACE_LATE_RESULT_POLICY=republish_if_changed
FACE_LATE_RESULT_GRACE_SEC=300
# annotate: attach the liveness verdict to every result (previous
#           behaviour, the default). reject: a track judged `fake`
#           publishes identity "0" with spoof_rejected=true and is not
#           re-queried. Calibrate liveness first (DEBUGGING.md) before
#           switching to reject.
FACE_LIVENESS_POLICY=annotate

# ---- detector side of the hub contract ---------------------------------
# A submitted task blocks the next one for the same track until the hub
# acks its result, or this long at most.
SUBMIT_TIMEOUT_SEC=15.0
TRACK_UPDATE_INTERVAL_SEC=5.0
# Only crops whose landmarks are this confident are sent (the
# recognizer drops the rest anyway) — mid-track AND finalize.
MIN_LANDMARK_CONF_FOR_SUBMIT=0.6
SEND_BEST_FRAME_MIDTRACK=true
FINALIZE_MAX_CROPS=1

# =====================================================================
# OCCUPANCY HEATMAP (face_detector, detector/src/heatmap.py)
# Built from the head tracks the detector already has — no second model.
# Turn the gathering on/off here; one camera can override it with
# "heatmap": true/false in its face:cameras:config entry.
# Output: MinIO <FACE_HEATMAP_MINIO_BUCKET>/<camera_id>/<YYYY-MM-DD>.npy,
# a uint32 cube (slots x GRID_HEIGHT x GRID_WIDTH) — same format as
# heatmap-service. Every flush is announced on face:heatmap:results.
# =====================================================================
FACE_HEATMAP_ENABLED=true
FACE_HEATMAP_MINIO_BUCKET=face-heatmap
HEATMAP_GRID_WIDTH=128
HEATMAP_GRID_HEIGHT=72
# changing this changes the cube shape (a mid-day change writes a sibling object)
HEATMAP_TIME_RESOLUTION_MINUTES=5
# every N frames each live head track adds one point (dwell-weighted)
HEATMAP_SAMPLE_EVERY_N_FRAMES=10
# center (head centre) | bottom_center
HEATMAP_POINT_MODE=center
# flush to MinIO; an unclean kill loses at most this much
HEATMAP_SAVE_INTERVAL_SEC=60

# =====================================================================
# SHARED
# =====================================================================
LOG_LEVEL=INFO
# text  — human-readable single-line logs (default, best for `docker
#         compose logs -f` while watching interactively)
# json  — one JSON object per line (event, fields, timestamp, level,
#         logger) — feed this to a log aggregator (Loki/ELK/CloudWatch)
#         once you have one. Same call sites, same messages, just a
#         different formatter — see common/facecore/logging_setup.py.
LOG_FORMAT=text
DETECTOR_MEMORY_LIMIT=8G
RECOGNIZER_MEMORY_LIMIT=4G
